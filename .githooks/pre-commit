#!/bin/sh
# Keep the committed .min files in step with their sources: whenever
# assets/webxv2/css/style.css or assets/webxv2/js/ds.js is part of a commit,
# rebuild its .min from the STAGED source and stage it.
# Activated by `npm install` (package.json "prepare" sets core.hooksPath).
staged=$(git diff --cached --name-only)
css=$(echo "$staged" | grep -qx 'assets/webxv2/css/style.css' && echo 1)
js=$(echo "$staged" | grep -qx 'assets/webxv2/js/ds.js' && echo 1)
[ -z "$css$js" ] && exit 0

major=$(node -p 'process.versions.node.split(".")[0]' 2>/dev/null || echo 0)
if [ "$major" -lt 18 ]; then
  echo "pre-commit: rebuilding the .min files needs Node 18+ (found $(node -v 2>/dev/null || echo none)) — run: nvm use" >&2
  exit 1
fi
if [ ! -d node_modules/esbuild ]; then
  echo "pre-commit: style.css / ds.js changed but esbuild is missing — run: npm install" >&2
  exit 1
fi
if [ -n "$css" ]; then
  node scripts/minify.mjs --css --staged || exit 1
  git add assets/webxv2/css/style.min.css
fi
if [ -n "$js" ]; then
  node scripts/minify.mjs --js --staged || exit 1
  git add assets/webxv2/js/ds.min.js
fi
